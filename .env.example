# Copy to .env and fill in. The server refuses to boot without these.

# Password for the single-user login screen.
PADDO_PASSWORD=

# HMAC secret for signing the session cookie. Generate: openssl rand -hex 32
PADDO_SECRET=

# Bearer token the MCP server uses against the HTTP API. Generate: openssl rand -hex 32
PADDO_TOKEN=

# Where the .md files live, relative to the repo root.
PADDO_CONTENT_DIR=content

# Where the CRDT sidecars live. Tests point this at a throwaway directory.
PADDO_SIDECAR_DIR=.paddo

# 0.0.0.0 so the phone can reach it over the LAN.
PADDO_HOST=0.0.0.0
PADDO_PORT=4319

# Behind a reverse proxy (Caddy, nginx, tailscale serve), on: the login throttle
# then keys on the real client address from X-Forwarded-For instead of treating the
# proxy as one client. Leave off — or empty — when nothing is in front: an instance
# reachable directly would believe a caller's own X-Forwarded-For.
PADDO_TRUST_PROXY=false

# Warn by default in production. `info` when the question is "did the file watcher
# actually start", `debug` never.
PADDO_LOG_LEVEL=warn
